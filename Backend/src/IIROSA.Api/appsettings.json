{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=IIROSA_Db;Trusted_Connection=True;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=True"
  },
  "JwtIdentitySettingDto": {
    "Key": "YourSuperSecretKeyWith32CharactersLength!!",
    "Issuer": "IIROSAApi",
    "Audience": "IIROSAClient"
  },
  "Jwt": {
    "Key": "YourSuperSecretKeyWith32CharactersLength!!",
    "Issuer": "IIROSAApi",
    "Audience": "IIROSAClient",
    "Secret": "YourSuperSecretKeyHere123456789012",
    "ExpirationInMinutes": 1440,
    "DurationInMinutes": 60
  },
  "UploadPath": "Uploads",
  "Swagger": {
    "Title": "IIROSA API",
    "Version": "v1",
    "Description": "IIROSA Orphan Management System API - Built with Framework.Core & Framework.Identity"
  },
  "Notification": {
    "EmailFromAddress": "noreply@iirosa.org",
    "EmailFromName": "IIROSA System",
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUserName": "your-email@gmail.com",
    "SmtpPassword": "your-app-password",
    "IsSmtpAuthenticated": true,
    "SmtpEnableSSL": true
  },
  "Cors": {
    "AllowedOrigins": [
      "https://iirosa.org",
      "https://www.iirosa.org",
      "https://admin.iirosa.org",
      "https://api.iirosa.org",
      "http://localhost:4200"
    ]
  }
}
