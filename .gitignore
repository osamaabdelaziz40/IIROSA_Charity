# .NET Core / Visual Studio
## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Node.js (Angular Frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.node_repl_history

# Angular specific
.angular/
dist/
*.ngbuilder

# TypeScript
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Claude Code / BMAD Method
# Track the BMAD framework, skills and generated artifacts — they are project deliverables.
# Ignore only local, machine-specific settings.
.claude/settings.local.json
.claude/temp/

# Build artifacts
*.log
*.pid
*.seed
*.pid.lock

# Testing
coverage/
.nyc_output/

# Runtime uploads — the attachment store is created at run time, not shipped.
# Keep the folder, never its contents.
Backend/src/IIROSA.Api/Attachments/*
!Backend/src/IIROSA.Api/Attachments/.gitkeep

# Misc
*.pfx
*.publishsettings
orleans.codegen.cs