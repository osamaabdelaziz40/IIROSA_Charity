+<app-breadcrumb [items]="breadcrumbs"></app-breadcrumb>
+<app-page-header
+  [title]="'incomingOutgoing.attachEmployeesTitle' | translate"
+  [subtitle]="'incomingOutgoing.attachEmployeesSubtitle' | translate"
+  [icon]="'fe fe-users'"
+  [actions]="pageActions">
+</app-page-header>
+
+<div class="card">
+  <div class="card-body">
+    <!-- §21.S.3 selection fields -->
+    <form [formGroup]="filterForm">
+      <div class="row mb-3">
+        <!-- الجمعية (HQ only) -->
+        <div class="col-md-4" *ngIf="isSuperAdmin">
+          <app-drop-down
+            [fg]="filterForm"
+            fcn="selectedCharity"
+            [label]="'incomingOutgoing.charity'"
+            [initialData]="charityOptions"
+            [hasDefaultValue]="true"
+            (onDropDownChanged)="onCharityChange()">
+          </app-drop-down>
+        </div>
+
+        <!-- خطاب الوارد -->
+        <div class="col-md-5">
+          <app-drop-down
+            [fg]="filterForm"
+            fcn="selectedLetter"
+            [label]="'incomingOutgoing.selectLetter'"
+            [initialData]="letterOptions"
+            (onDropDownChanged)="onLetterChange()">
+          </app-drop-down>
+        </div>
+
+        <!-- Pending-changes indicator -->
+        <div class="col-md-3 d-flex align-items-end" *ngIf="hasPendingChanges">
+          <span class="badge badge-warning">
+            <i class="fe fe-alert-circle mr-1"></i>
+            {{ 'incomingOutgoing.pendingChanges' | translate }}
+          </span>
+        </div>
+      </div>
+    </form>
+
+    <!-- Loading State -->
+    <div *ngIf="loadingEmployees" class="text-center py-5">
+      <div class="spinner-border text-primary" role="status">
+        <span class="sr-only">{{ 'common.loading' | translate }}</span>
+      </div>
+    </div>
+
+    <!-- The two §21.S.3 grids -->
+    <div class="row" *ngIf="!loadingEmployees && selectedLetterId">
+      <!-- Unattached employees -->
+      <div class="col-md-6">
+        <div class="card">
+          <div class="card-header">
+            <h5 class="card-title mb-0">
+              <i class="fe fe-user-plus mr-1"></i>
+              {{ 'incomingOutgoing.unattachedEmployees' | translate }}
+            </h5>
+          </div>
+          <div class="card-body p-0">
+            <div class="table-responsive">
+              <table class="table table-hover mb-0">
+                <thead>
+                  <tr>
+                    <th>#</th>
+                    <th>{{ 'incomingOutgoing.employeeName' | translate }}</th>
+                    <th class="text-center">{{ 'common.actions' | translate }}</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  <tr *ngFor="let employee of availableEmployees; let i = index; trackBy: trackByUserId"
+                      [class.table-warning]="employee.staged === 'detach'">
+                    <td>{{ i + 1 }}</td>
+                    <td>{{ employee.fullName }}</td>
