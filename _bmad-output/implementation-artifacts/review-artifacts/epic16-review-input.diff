+<app-breadcrumb [items]="breadcrumbs"></app-breadcrumb>
+<app-page-header
+  [title]="'incomingOutgoing.orphansReportTitle' | translate"
+  [subtitle]="'incomingOutgoing.orphansReportSubtitle' | translate"
+  [icon]="'fe fe-bar-chart-2'"
+  [actions]="pageActions">
+</app-page-header>
+
+<div class="card">
+  <div class="card-body">
+    <!-- §21.S.7 filters — ChildCode mandatory -->
+    <form [formGroup]="filterForm">
+      <div class="row mb-3">
+        <!-- ChildCode (mandatory) -->
+        <div class="col-md-3">
+          <app-input-text
+            [fg]="filterForm"
+            fcn="childCode"
+            [label]="'incomingOutgoing.orphanCode'"
+            [placeholder]="'incomingOutgoing.orphanCodePlaceholder' | translate"
+            [required]="true">
+          </app-input-text>
+        </div>
+
+        <!-- Charity (HQ only) -->
+        <div class="col-md-2" *ngIf="isSuperAdmin">
+          <app-drop-down
+            [fg]="filterForm"
+            fcn="selectedCharity"
+            [label]="'incomingOutgoing.charity'"
+            [initialData]="charityOptions"
+            [hasDefaultValue]="true">
+          </app-drop-down>
+        </div>
+
+        <!-- Serial -->
+        <div class="col-md-2">
+          <app-input-text
+            [fg]="filterForm"
+            fcn="serial"
+            [label]="'incomingOutgoing.serial'"
+            type="number">
+          </app-input-text>
+        </div>
+
+        <!-- Year -->
+        <div class="col-md-2">
+          <app-input-text
+            [fg]="filterForm"
+            fcn="year"
+            [label]="'incomingOutgoing.year'"
+            type="number">
+          </app-input-text>
+        </div>
+
+        <!-- Date from -->
+        <div class="col-md-1">
+          <app-input-text
+            [fg]="filterForm"
+            fcn="dateFrom"
+            [label]="'incomingOutgoing.startDate'"
+            type="date">
+          </app-input-text>
+        </div>
+
+        <!-- Date to -->
+        <div class="col-md-1">
+          <app-input-text
+            [fg]="filterForm"
+            fcn="dateTo"
+            [label]="'incomingOutgoing.endDate'"
+            type="date">
+          </app-input-text>
+        </div>
+
+        <!-- بحث -->
+        <div class="col-md-1">
+          <button type="button" class="btn btn-primary btn-sm mt-4" (click)="search()">
+            <i class="fe fe-search"></i>
+          </button>
+        </div>
+      </div>
+
+      <div class="row mb-3">
+        <div class="col-12">
+          <button type="button" class="btn btn-sm btn-outline-secondary" (click)="resetFilters()">
+            <i class="fe fe-x mr-1"></i>
+            {{ 'common.clearFilters' | translate }}
+          </button>
+        </div>
+      </div>
+    </form>
+
+    <!-- Loading State -->
+    <div *ngIf="loading" class="text-center py-5">
+      <div class="spinner-border text-primary" role="status">
+        <span class="sr-only">{{ 'common.loading' | translate }}</span>
+      </div>
+    </div>
+
+    <!-- Report grid (§21.S.7) -->
+    <div class="table-responsive" *ngIf="!loading">
+      <table class="table table-hover table-striped">
+        <thead>
+          <tr>
+            <th>{{ 'incomingOutgoing.serial' | translate }}</th>
+            <th>{{ 'incomingOutgoing.year' | translate }}</th>
+            <th>{{ 'incomingOutgoing.date' | translate }}</th>
+            <th>{{ 'incomingOutgoing.charity' | translate }}</th>
+            <th>{{ 'incomingOutgoing.orphansCount' | translate }}</th>
+            <th>{{ 'incomingOutgoing.orphanAttached' | translate }}</th>
+          </tr>
+        </thead>
+        <tbody>
+          <tr *ngFor="let row of rows; trackBy: trackById">
+            <td>{{ row.serial != null ? ('0000' + row.serial).slice(-4) : '-' }}</td>
+            <td>{{ row.year || '-' }}</td>
+            <td>{{ formatDate(row.letterDate) }}</td>
+            <td>{{ row.charityName || '-' }}</td>
+            <td>{{ row.orphanCount }}</td>
+            <td>
+              <span class="badge" [ngClass]="row.orphanAttached ? 'badge-success' : 'badge-secondary'">
+                {{ (row.orphanAttached ? 'common.yes' : 'common.no') | translate }}
+              </span>
+            </td>
+          </tr>
+          <tr *ngIf="rows.length === 0">
+            <td colspan="6" class="text-center py-5">
+              <div class="empty-state">
+                <i class="fe fe-bar-chart-2 fe-3x text-muted mb-3"></i>
+                <p class="text-muted">{{ (searched ? 'incomingOutgoing.noReportRows' : 'incomingOutgoing.reportNotRun') | translate }}</p>
+              </div>
+            </td>
+          </tr>
+        </tbody>
+      </table>
+    </div>
+
+    <!-- Pagination -->
+    <app-pagination
+      [currentPage]="currentPage"
+      [pageSize]="pageSize"
+      [totalCount]="totalCount"
+      (pageChange)="changePage($event)">
+    </app-pagination>
+  </div>
+</div>
