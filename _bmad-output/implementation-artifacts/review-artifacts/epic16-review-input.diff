+using Framework.Identity.Data.Entities;
+using IIROSA.Domain.Contracts.Persistence;
+using IIROSA.Domain.Entities;
+using IIROSA.Domain.Interfaces;
+using IIROSA.Infrastructure.Data;
+using Microsoft.EntityFrameworkCore;
+
+namespace IIROSA.Infrastructure.Data.Repository;
+
+/// <summary>
+/// Incoming ↔ Employee link repository (epic 16, UC-COR-09).
+/// Identity users are read through the remapped Users table (see ApplicationDbContext) —
+/// flat projections only, never tracked ApplicationUser entities.
+/// </summary>
+public class IncomingEmployeeRepository : Repository<IncomingEmployee>, IIncomingEmployeeRepository
+{
+    private readonly DbSet<IncomingEmployee> _dbSet;
+    private readonly ApplicationDbContext _context;
+
+    public IncomingEmployeeRepository(ApplicationDbContext context) : base(context)
+    {
+        _dbSet = context.Set<IncomingEmployee>();
+        _context = context;
+    }
+
+    public async Task<IEnumerable<IncomingEmployee>> GetByIncomingAsync(Guid incomingId)
+    {
+        return await _dbSet
+            .Include(e => e.User)
+            .Where(e => e.IncomingId == incomingId)
+            .OrderBy(e => e.CreatedOn)
+            .ToListAsync();
+    }
+
+    public async Task<bool> ExistsAsync(Guid incomingId, Guid userId)
+    {
+        return await _dbSet.AnyAsync(e => e.IncomingId == incomingId && e.UserId == userId);
+    }
+
+    public async Task<IEnumerable<EmployeeCandidateRow>> GetAvailableEmployeesAsync(Guid incomingId)
+    {
+        var linkedUserIds = await _dbSet
+            .Where(e => e.IncomingId == incomingId)
+            .Select(e => e.UserId)
+            .ToListAsync();
+
+        return await _context.Set<ApplicationUser>()
+            .Where(u => u.IsActive && !linkedUserIds.Contains(u.Id))
+            .OrderBy(u => u.FullName)
+            .Select(u => new EmployeeCandidateRow
+            {
+                UserId = u.Id,
+                FullName = u.FullName,
+                Email = u.Email
+            })
+            .ToListAsync();
+    }
+}
diff --git a/Backend/src/IIROSA.Infrastructure/Data/Repository/OutgoingOrphanReportRepository.cs b/Backend/src/IIROSA.Infrastructure/Data/Repository/OutgoingOrphanReportRepository.cs
new file mode 100644
index 0000000..51e06f6
--- /dev/null
+++ b/Backend/src/IIROSA.Infrastructure/Data/Repository/OutgoingOrphanReportRepository.cs
@@ -0,0 +1,148 @@
+using IIROSA.Domain.Contracts.Persistence;
+using IIROSA.Domain.Entities;
+using IIROSA.Domain.Interfaces;
+using IIROSA.Infrastructure.Data;
+using Microsoft.EntityFrameworkCore;
+
+namespace IIROSA.Infrastructure.Data.Repository;
+
+/// <summary>
+/// Outgoing ↔ Orphan report link repository (epic 16, UC-COR-18 / UC-COR-19).
+/// The §21.S.6 grids and the §21.S.7 report are served as flat projections — orphan
+/// name/code/guarantor/kinship and charity name are joined server-side.
+/// </summary>
+public class OutgoingOrphanReportRepository : Repository<OutgoingOrphanReport>, IOutgoingOrphanReportRepository
+{
+    private readonly DbSet<OutgoingOrphanReport> _dbSet;
+    private readonly ApplicationDbContext _context;
+
+    public OutgoingOrphanReportRepository(ApplicationDbContext context) : base(context)
+    {
+        _dbSet = context.Set<OutgoingOrphanReport>();
+        _context = context;
+    }
+
+    public async Task<IEnumerable<OutgoingOrphanReport>> GetByOutgoingAsync(Guid outgoingId)
+    {
+        return await _dbSet
+            .Include(r => r.Orphan).ThenInclude(o => o!.Family)
+            .Where(r => r.OutgoingId == outgoingId)
+            .OrderBy(r => r.CreatedOn)
+            .ToListAsync();
+    }
+
+    public Task<bool> IsOrphanAttachedAsync(Guid orphanId)
+    {
+        return _dbSet.AnyAsync(r => r.OrphanId == orphanId);
+    }
+
+    public Task<OutgoingOrphanReport?> FindByLetterAndOrphanAsync(Guid outgoingId, Guid orphanId)
+    {
+        return _dbSet.FirstOrDefaultAsync(r => r.OutgoingId == outgoingId && r.OrphanId == orphanId);
+    }
+
+    public async Task<IEnumerable<OrphanCandidateRow>> GetUnattachedOrphansAsync(Guid? charityId)
+    {
+        var attachedOrphanIds = await _dbSet.Select(r => r.OrphanId).ToListAsync();
+
+        var query = _context.Set<Orphan>()
+            .Where(o => !attachedOrphanIds.Contains(o.Id));
+
+        if (charityId.HasValue)
+        {
+            // BR-27 — the selection is scoped to the letter's charity
+            query = query.Where(o => o.FK_CharityId == charityId.Value);
+        }
+
+        return await query
+            .OrderBy(o => o.Code)
+            .Select(o => new OrphanCandidateRow
+            {
+                OrphanId = o.Id,
+                Code = o.Code,
+                FullName = o.FullName,
+                GuarantorName = o.Family != null ? o.Family.HeadOfFamily : null,
+                Kinship = o.Family != null ? o.Family.ProviderType : null
+            })
+            .ToListAsync();
+    }
+
+    public async Task<(IEnumerable<OutgoingOrphanReportRow> Rows, int TotalCount)> GetOrphanReportAsync(
+        int? serial,
+        int? year,
+        Guid? charityId,
+        DateTime? dateFrom,
+        DateTime? dateTo,
+        string childCode,
+        int pageNumber,
+        int pageSize)
+    {
+        // §21.S.7: rows are the outgoing letters carrying the requested orphan's report
+        var letters = from link in _dbSet
+                      join orphan in _context.Set<Orphan>() on link.OrphanId equals orphan.Id
+                      where orphan.Code == childCode
+                      join outgoing in _context.Set<Outgoing>() on link.OutgoingId equals outgoing.Id
+                      join charity in _context.Set<Charity>() on outgoing.FK_CharityId equals charity.Id into charityGroup
+                      from charity in charityGroup.DefaultIfEmpty()
+                      select new
+                      {
+                          Outgoing = outgoing,
+                          CharityName = charity != null ? charity.Name : null
+                      };
+
+        var filtered = letters;
+        if (serial.HasValue)
+        {
+            filtered = filtered.Where(x => x.Outgoing.Serial == serial.Value);
+        }
+
+        if (year.HasValue)
+        {
+            filtered = filtered.Where(x => x.Outgoing.Year == year.Value);
+        }
+
+        if (charityId.HasValue)
+        {
+            filtered = filtered.Where(x => x.Outgoing.FK_CharityId == charityId.Value);
+        }
+
+        if (dateFrom.HasValue)
+        {
+            filtered = filtered.Where(x => x.Outgoing.Date >= dateFrom.Value);
+        }
+
+        if (dateTo.HasValue)
+        {
+            filtered = filtered.Where(x => x.Outgoing.Date <= dateTo.Value);
+        }
+
+        var totalCount = await filtered.CountAsync();
+
+        // Per-letter orphan counts come from the full live-link set of the matched letters
+        var page = await filtered
+            .OrderByDescending(x => x.Outgoing.Date ?? x.Outgoing.CreatedOn)
+            .Skip((pageNumber - 1) * pageSize)
+            .Take(pageSize)
+            .ToListAsync();
+
+        var letterIds = page.Select(x => x.Outgoing.Id).ToList();
+        var counts = await _dbSet
+            .Where(r => letterIds.Contains(r.OutgoingId))
+            .GroupBy(r => r.OutgoingId)
+            .Select(g => new { OutgoingId = g.Key, Count = g.Count() })
+            .ToDictionaryAsync(x => x.OutgoingId, x => x.Count);
+
+        var rows = page.Select(x => new OutgoingOrphanReportRow
+        {
+            OutgoingId = x.Outgoing.Id,
+            Serial = x.Outgoing.Serial,
+            Year = x.Outgoing.Year,
+            LetterDate = x.Outgoing.Date,
+            CharityName = x.CharityName,
+            OrphanCount = counts.TryGetValue(x.Outgoing.Id, out var count) ? count : 0,
+            OrphanAttached = true
+        }).ToList();
+
+        return (rows, totalCount);
+    }
+}
