+    private async Task AttachProviderChangeOrphanCodesAsync(
+        List<ProviderChangeReportRowDto> items,
+        CancellationToken cancellationToken)
+    {
+        var familyIds = items
+            .Where(r => r.FamilyId.HasValue)
