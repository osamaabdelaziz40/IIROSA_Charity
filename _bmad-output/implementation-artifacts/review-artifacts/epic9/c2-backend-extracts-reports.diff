+    /// <inheritdoc />
+    public async Task<ReportPagedResult<OrphansMissingReportsSummaryDto>> GetOrphansMissingReportsAsync(
+        OrphansMissingReportsFilterDto filter,
+        CancellationToken cancellationToken = default)
