diff --git a/Frontend/src/app/modules/periodic-orphan-reports/report-attachment-gallery/report-attachment-gallery.component.ts b/Frontend/src/app/modules/periodic-orphan-reports/report-attachment-gallery/report-attachment-gallery.component.ts
