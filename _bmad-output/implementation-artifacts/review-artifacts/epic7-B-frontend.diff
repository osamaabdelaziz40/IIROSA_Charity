+</div>
+
+<!-- §12.S.2 — اضافة مرافق (staged rows, submitted with the family) -->
+<div class="card mb-4">
+  <div class="card-header d-flex justify-content-between align-items-center">
+    <h5 class="mb-0">{{ 'families.refugeeSectionCompanions' | translate }}</h5>
+    <button type="button" class="btn btn-sm btn-primary" (click)="addCompanionRow()">
+      <i class="fe fe-plus mr-1"></i>
+      {{ 'families.refugeeAddCompanion' | translate }}
+    </button>
+  </div>
+  <div class="card-body">
+    <form [formGroup]="familyForm">
+      <div formArrayName="relatives">
+        <div class="row align-items-end stage-row" *ngFor="let _ of companionsForm.controls; let i = index; trackBy: trackByIndex">
+          <div class="col-md-3" [formGroupName]="i">
+            <app-input-text
+              [fg]="companionGroup(i)"
+              fcn="fullName"
+              [label]="'families.refugeeCompanionName'">
+            </app-input-text>
+          </div>
+
+          <div class="col-md-2" [formGroupName]="i">
+            <app-input-text
+              [fg]="companionGroup(i)"
+              fcn="nationalId"
+              [label]="'families.refugeeCompanionNationalId'">
+            </app-input-text>
+          </div>
+
+          <div class="col-md-2" [formGroupName]="i">
+            <app-input-text
+              [fg]="companionGroup(i)"
+              fcn="dateOfBirth"
+              type="date"
+              [label]="'families.refugeeCompanionDOB'">
+            </app-input-text>
+          </div>
+
+          <div class="col-md-2" [formGroupName]="i">
+            <app-drop-down
+              [fg]="companionGroup(i)"
+              fcn="gender"
+              [label]="'families.refugeeCompanionGender'"
+              [initialData]="genderOptions">
+            </app-drop-down>
