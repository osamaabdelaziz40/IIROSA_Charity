+
+          <div class="col-md-2" [formGroupName]="i">
+            <app-input-text
+              [fg]="childGroup(i)"
+              fcn="nationalId"
+              [label]="'families.refugeeChildNationalId'">
+            </app-input-text>
+          </div>
+
+          <div class="col-md-2" [formGroupName]="i">
+            <app-drop-down
+              [fg]="childGroup(i)"
+              fcn="socialStatusId"
