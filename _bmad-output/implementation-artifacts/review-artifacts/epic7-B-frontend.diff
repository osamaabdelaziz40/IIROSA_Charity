+
+<!-- §12.S.2 — اضافة ابن (staged rows, submitted with the family) -->
+<div class="card mb-4">
+  <div class="card-header d-flex justify-content-between align-items-center">
+    <h5 class="mb-0">{{ 'families.refugeeSectionChildren' | translate }}</h5>
+    <button type="button" class="btn btn-sm btn-primary" (click)="addChildRow()">
+      <i class="fe fe-plus mr-1"></i>
+      {{ 'families.refugeeAddChild' | translate }}
