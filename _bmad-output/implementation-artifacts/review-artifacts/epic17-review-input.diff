+<app-breadcrumb [items]="breadcrumbs"></app-breadcrumb>
+<app-page-header [title]="'hqTransfers.details.title'"></app-page-header>
+
+<div class="container-fluid">
+  <div class="row">
+    <div class="col-12">
+      <div class="card shadow">
+        <div class="card-body">
+
+          <!-- Loading -->
+          <div *ngIf="loading" class="text-center py-5">
+            <div class="spinner-border text-primary" role="status">
+              <span class="sr-only">{{ 'common.loading' | translate }}</span>
+            </div>
+          </div>
+
+          <!-- Not found: absent, soft-deleted, or outside the caller's country scope -->
+          <div *ngIf="!loading && notFound" class="text-center py-5">
+            <p class="text-muted mb-3">{{ 'hqTransfers.transferNotFound' | translate }}</p>
+            <button type="button" class="btn btn-secondary" (click)="backToList()">
+              <i class="fe fe-arrow-right mr-1"></i>{{ 'common.back' | translate }}
+            </button>
+          </div>
+
+          <ng-container *ngIf="!loading && !notFound && header">
+
+            <!-- Header summary (UC-TRF-08 AC 1): the parent transfer the lines allocate -->
+            <div class="header-summary mb-3">
+              <div class="row">
+                <div class="col-md-4">
+                  <span class="text-muted">{{ 'hqTransfers.operationNumber' | translate }}:</span>
+                  <strong class="mx-1">{{ header.operationNumber }}</strong>
+                </div>
+                <div class="col-md-4">
+                  <span class="text-muted">{{ 'hqTransfers.amountOfPayment' | translate }}:</span>
+                  <strong class="mx-1">{{ header.amountOfPayment }}</strong>
+                </div>
+                <div class="col-md-4">
+                  <span class="text-muted">{{ 'hqTransfers.country' | translate }}:</span>
+                  <strong class="mx-1">{{ header.countryName || '—' }}</strong>
+                </div>
+              </div>
+            </div>
+
+            <!-- Add line (§22.S.3 «+ تفاصيل») — one empty editable row locally, nothing written until its save -->
+            <div class="mb-2 text-end" *ngIf="canEdit">
+              <button type="button" class="btn btn-primary btn-sm" (click)="addLine()">
+                <i class="fe fe-plus mr-1"></i>{{ 'hqTransfers.details.addLine' | translate }}
+              </button>
+            </div>
+
+            <!-- §22.S.3 grid: رقم الحوالة · مبلغ الحوالة · التاريخ المتوقع للتحويل · مصير الحوالة ·
+                 تاريخ التنفيذ · تاريخ وصول الحوالة · مبلغ الوصول · حفظ -->
+            <div class="table-responsive">
+              <table class="table table-hover table-bordered details-grid">
+                <thead>
+                  <tr>
+                    <th class="text-center" style="width: 60px;">{{ 'hqTransfers.serial' | translate }}</th>
+                    <th style="width: 160px;">{{ 'hqTransfers.details.transferNumber' | translate }}</th>
+                    <th style="width: 130px;">{{ 'hqTransfers.details.amount' | translate }}</th>
+                    <th style="width: 150px;">{{ 'hqTransfers.details.estimatedTransferDate' | translate }}</th>
+                    <th style="width: 150px;">{{ 'hqTransfers.details.isExecuted' | translate }}</th>
+                    <th style="width: 150px;">{{ 'hqTransfers.details.executionDate' | translate }}</th>
+                    <th style="width: 150px;">{{ 'hqTransfers.details.arrivalDate' | translate }}</th>
+                    <th style="width: 130px;">{{ 'hqTransfers.details.arrivalAmount' | translate }}</th>
+                    <th class="text-center" style="width: 110px;" *ngIf="canEdit">{{ 'common.save' | translate }}</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  <tr *ngFor="let row of rows; let i = index; trackBy: trackRow">
+
+                    <!-- Writer view: one editable row, per-row «حفظ» -->
+                    <ng-container *ngIf="canEdit">
+                      <td class="text-center">{{ i + 1 }}</td>
+                      <td>
+                        <input type="text"
+                               class="form-control form-control-sm"
+                               [class.is-invalid]="row.errors['transferNumber']"
+                               [(ngModel)]="row.transferNumber"
+                               [disabled]="row.saving"
+                               maxlength="50">
+                        <div class="invalid-feedback d-block" *ngIf="row.errors['transferNumber']">{{ row.errors['transferNumber'] }}</div>
+                      </td>
+                      <td>
+                        <input type="number"
+                               class="form-control form-control-sm"
+                               [class.is-invalid]="row.errors['amount']"
+                               [(ngModel)]="row.amount"
+                               min="0.01"
+                               step="0.01"
+                               [disabled]="row.saving">
+                        <div class="invalid-feedback d-block" *ngIf="row.errors['amount']">{{ row.errors['amount'] }}</div>
+                      </td>
+                      <td>
+                        <input type="date"
+                               class="form-control form-control-sm"
+                               [(ngModel)]="row.estimatedTransferDate"
+                               [disabled]="row.saving">
+                      </td>
+                      <td>
+                        <select class="form-control form-control-sm"
+                                [class.is-invalid]="row.errors['isExecuted']"
+                                [(ngModel)]="row.isExecuted"
+                                [disabled]="row.saving">
+                          <option [ngValue]="null">{{ 'hqTransfers.details.selectState' | translate }}</option>
+                          <option [ngValue]="false">{{ 'hqTransfers.details.notExecuted' | translate }}</option>
+                          <option [ngValue]="true">{{ 'hqTransfers.details.executed' | translate }}</option>
+                        </select>
+                        <div class="invalid-feedback d-block" *ngIf="row.errors['isExecuted']">{{ row.errors['isExecuted'] }}</div>
+                      </td>
+                      <td>
+                        <!-- «Failed Operation» gating as UX: enterable only once مصير الحوالة = تم التنفيذ -->
+                        <input type="date"
+                               class="form-control form-control-sm"
+                               [(ngModel)]="row.executionDate"
+                               [disabled]="row.saving || row.isExecuted !== true">
+                      </td>
+                      <td>
+                        <input type="date"
+                               class="form-control form-control-sm"
+                               [(ngModel)]="row.arrivalDate"
+                               [disabled]="row.saving || row.isExecuted !== true">
+                      </td>
+                      <td>
+                        <input type="number"
+                               class="form-control form-control-sm"
+                               [(ngModel)]="row.arrivalAmount"
+                               min="0.01"
+                               step="0.01"
+                               [disabled]="row.saving || row.isExecuted !== true">
+                      </td>
+                      <td class="text-center">
+                        <button type="button"
+                                class="btn btn-primary btn-sm"
+                                [disabled]="row.saving"
+                                (click)="saveRow(row)">
+                          <span class="spinner-border spinner-border-sm mr-1" *ngIf="row.saving"></span>
+                          <i class="fe fe-save mr-1" *ngIf="!row.saving"></i>
+                          {{ 'common.save' | translate }}
+                        </button>
+                      </td>
+                    </ng-container>
+
+                    <!-- Reader view (no HqTransfers.Edit): plain cells, state as a label -->
+                    <ng-container *ngIf="!canEdit">
+                      <td class="text-center">{{ i + 1 }}</td>
+                      <td>{{ row.transferNumber }}</td>
+                      <td>{{ row.amount }}</td>
+                      <td>{{ row.estimatedTransferDate || '—' }}</td>
+                      <td><span class="badge" [class.badge-success]="row.isExecuted === true" [class.badge-secondary]="row.isExecuted !== true">{{ stateLabel(row.isExecuted) }}</span></td>
+                      <td>{{ row.executionDate || '—' }}</td>
+                      <td>{{ row.arrivalDate || '—' }}</td>
+                      <td>{{ row.arrivalAmount ?? '—' }}</td>
+                    </ng-container>
+
+                  </tr>
+                  <tr *ngIf="rows.length === 0">
+                    <td colspan="9" class="text-center text-muted py-4">{{ 'hqTransfers.details.noLines' | translate }}</td>
+                  </tr>
+                </tbody>
+              </table>
+            </div>
+
+            <div class="mt-3">
+              <button type="button" class="btn btn-secondary" (click)="backToList()">
+                <i class="fe fe-arrow-right mr-1"></i>{{ 'common.back' | translate }}
+              </button>
+            </div>
+
+          </ng-container>
+        </div>
+      </div>
+    </div>
+  </div>
+</div>
