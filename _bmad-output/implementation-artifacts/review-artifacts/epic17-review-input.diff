+<div class="container-fluid">
+  <div class="row">
+    <div class="col-12">
+      <div class="card shadow">
+        <div class="card-body">
+          <!-- Empty value = unlimited (UC-TRF-07 AC 3) -->
+          <p class="text-muted mb-3">{{ 'hqTransfers.maxAmounts.hint' | translate }}</p>
+
+          <!-- Loading -->
+          <div *ngIf="loading" class="text-center py-5">
+            <div class="spinner-border text-primary" role="status">
+              <span class="sr-only">{{ 'common.loading' | translate }}</span>
+            </div>
+          </div>
+
+          <!-- Grid (§22.S.4): الرقم · البلد · قيمة الحوالة · حفظ -->
+          <div class="table-responsive" *ngIf="!loading">
+            <table class="table table-hover table-bordered">
+              <thead>
+                <tr>
+                  <th class="text-center" style="width: 80px;">{{ 'hqTransfers.maxAmounts.serial' | translate }}</th>
+                  <th>{{ 'hqTransfers.maxAmounts.country' | translate }}</th>
+                  <th style="width: 260px;">{{ 'hqTransfers.maxAmounts.value' | translate }}</th>
+                  <th class="text-center" style="width: 140px;" *ngIf="canManage">{{ 'common.actions' | translate }}</th>
+                </tr>
+              </thead>
+              <tbody>
+                <tr *ngFor="let row of rows; let i = index; trackBy: trackRow">
+                  <td class="text-center">{{ i + 1 }}</td>
+                  <td>{{ row.name }}</td>
+                  <td>
+                    <!-- SuperAdmin: editable numeric box (empty ⇒ NULL ⇒ unlimited) -->
+                    <div *ngIf="canManage" class="input-group">
+                      <input type="number"
+                             class="form-control"
+                             [class.is-invalid]="row.error"
+                             [ngModel]="row.editValue"
+                             (ngModelChange)="row.editValue = $event"
+                             [placeholder]="'hqTransfers.maxAmounts.enterValue' | translate"
+                             min="0.01"
+                             step="0.01"
+                             [disabled]="row.saving">
+                      <div class="input-group-append">
+                        <button type="button"
+                                class="btn btn-primary"
+                                [disabled]="row.saving || !isDirty(row)"
+                                (click)="saveRow(row)">
+                          <span class="spinner-border spinner-border-sm mr-1" *ngIf="row.saving"></span>
+                          <i class="fe fe-save mr-1" *ngIf="!row.saving"></i>
+                          {{ 'common.save' | translate }}
+                        </button>
+                      </div>
+                      <div class="invalid-feedback d-block" *ngIf="row.error">{{ row.error }}</div>
+                    </div>
+
+                    <!-- Admin: read-only — the value or "no limit configured" -->
+                    <span *ngIf="!canManage">
+                      <span *ngIf="row.savedValue !== null">{{ row.savedValue }}</span>
+                      <span class="text-muted" *ngIf="row.savedValue === null">{{ 'hqTransfers.maxAmounts.noLimit' | translate }}</span>
+                    </span>
+                  </td>
+                  <td class="text-center" *ngIf="canManage">
+                    <span class="text-muted" *ngIf="row.savedValue === null">{{ 'hqTransfers.maxAmounts.noLimit' | translate }}</span>
+                    <span *ngIf="row.savedValue !== null">{{ row.savedValue }}</span>
+                  </td>
+                </tr>
+                <tr *ngIf="!loading && rows.length === 0">
+                  <td colspan="4" class="text-center text-muted py-4">{{ 'common.noData' | translate }}</td>
+                </tr>
+              </tbody>
+            </table>
+          </div>
+        </div>
+      </div>
+    </div>
+  </div>
+</div>
