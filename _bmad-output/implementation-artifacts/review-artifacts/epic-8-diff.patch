+<app-breadcrumb [items]="breadcrumbs"></app-breadcrumb>
+
+<app-page-header
+  [title]="'orphanCoding.worklistTitle'"
+  [subtitle]="'orphanCoding.worklistSubtitle' | translate"
+  [icon]="'fe fe-list'">
+</app-page-header>
+
+<div class="card">
+  <div class="card-body">
+    <!-- §13.S.2 filter: الجمعية -->
+    <form [formGroup]="filterForm">
+      <div class="row mb-3">
+        <div class="col-md-4">
+          <app-drop-down
+            [fg]="filterForm"
+            fcn="charityId"
+            [label]="'orphanCoding.charity'"
+            [initialData]="charityOptions"
+            [hasDefaultValue]="true"
+            (onDropDownChanged)="onCharityChange()">
+          </app-drop-down>
+        </div>
+      </div>
+    </form>
+
+    <!-- Loading State -->
+    <div *ngIf="loading" class="text-center py-5">
+      <div class="spinner-border text-primary" role="status">
+        <span class="sr-only">{{ 'common.loading' | translate }}</span>
+      </div>
+    </div>
+
+    <!-- §13.S.2 grid: اسم الجمعية · اسم الأم · اسم الابن/الابنة · كود (^ = sortable) -->
+    <div *ngIf="!loading" class="table-responsive">
+      <table class="table table-hover table-striped">
+        <thead>
+          <tr>
+            <th>{{ 'orphanCoding.serial' | translate }}</th>
+            <th (click)="sortByColumn('CharityName')" class="cursor-pointer">
+              {{ 'orphanCoding.charity' | translate }}
+              <i [class]="sortIcon('CharityName')"></i>
+            </th>
+            <th (click)="sortByColumn('MotherName')" class="cursor-pointer">
+              {{ 'orphanCoding.motherName' | translate }}
+              <i [class]="sortIcon('MotherName')"></i>
+            </th>
+            <th (click)="sortByColumn('FullName')" class="cursor-pointer">
+              {{ 'orphanCoding.orphanName' | translate }}
+              <i [class]="sortIcon('FullName')"></i>
+            </th>
+            <th (click)="sortByColumn('Code')" class="cursor-pointer">
+              {{ 'orphanCoding.code' | translate }}
+              <i [class]="sortIcon('Code')"></i>
+            </th>
+            <th>{{ 'common.actions' | translate }}</th>
+          </tr>
+        </thead>
+        <tbody>
+          <tr *ngFor="let orphan of orphans; let i = index; trackBy: trackByOrphanId">
+            <td>{{ getSerial(i) }}</td>
+            <td>{{ orphan.charityName || '-' }}</td>
+            <td>{{ orphan.motherName || '-' }}</td>
+            <td>{{ orphan.fullName }}</td>
+            <td>
+              <!-- Inline code cell: display, or تعديل الكود edit (UC-ORP-05/06) -->
+              <ng-container *ngIf="editingOrphanId !== orphan.orphanId; else editCell">
+                <strong>{{ orphan.code || '-' }}</strong>
+              </ng-container>
+              <ng-template #editCell>
+                <div class="d-flex align-items-center">
+                  <input type="text" class="form-control form-control-sm code-input ml-1"
+                         [(ngModel)]="editCode"
+                         (ngModelChange)="onEditCodeChange()"
+                         [placeholder]="'orphanCoding.codePlaceholder' | translate"
+                         [ngModelOptions]="{ standalone: true }" />
+                  <ng-container [ngSwitch]="codeCheckStatus">
+                    <i *ngSwitchCase="'checking'" class="fe fe-loader text-muted"></i>
+                    <i *ngSwitchCase="'available'" class="fe fe-check-circle text-success"
+                       [title]="'orphanCoding.codeAvailable' | translate"></i>
+                    <i *ngSwitchCase="'taken'" class="fe fe-x-circle text-danger"
+                       [title]="'orphanCoding.codeTaken' | translate"></i>
+                  </ng-container>
+                </div>
+                <small class="text-danger" *ngIf="codeCheckStatus === 'taken' && codeCheckResult?.existingOrphanName">
+                  {{ 'orphanCoding.codeHeldBy' | translate }}: {{ codeCheckResult?.existingOrphanName }}
+                </small>
+              </ng-template>
+            </td>
+            <td>
+              <div class="btn-group">
+                <!-- تعديل الكود → SaveCode / CancelSavingCode (UC-ORP-05/06) -->
+                <ng-container *ngIf="editingOrphanId !== orphan.orphanId; else editActions">
+                  <button type="button" class="btn btn-sm btn-light"
+                          (click)="startEdit(orphan)"
+                          [title]="'orphanCoding.editCode' | translate">
+                    <i class="fe fe-edit-2"></i>
+                  </button>
+                  <!-- سجل الصرف — open the payment history (UC-ORP-08/09) -->
+                  <button type="button" class="btn btn-sm btn-light"
+                          (click)="selectOrphan(orphan)"
+                          [title]="'orphanCoding.paymentHistory' | translate">
+                    <i class="fe fe-file-text"></i>
+                  </button>
+                </ng-container>
+                <ng-template #editActions>
+                  <button type="button" class="btn btn-sm btn-success"
+                          (click)="saveCode(orphan)"
+                          [disabled]="saving || codeCheckStatus === 'taken' || codeCheckStatus === 'checking'"
+                          [title]="'orphanCoding.saveCode' | translate">
+                    <i class="fe fe-save"></i>
+                  </button>
+                  <button type="button" class="btn btn-sm btn-light"
+                          (click)="cancelEdit()"
+                          [title]="'orphanCoding.cancelCode' | translate">
+                    <i class="fe fe-x"></i>
+                  </button>
+                </ng-template>
+              </div>
+            </td>
+          </tr>
+
+          <!-- Empty State -->
+          <tr *ngIf="!loading && orphans.length === 0">
+            <td colspan="6" class="text-center py-5">
+              <div class="empty-state">
+                <i class="fe fe-inbox fe-3x text-muted mb-3"></i>
+                <p class="text-muted">{{ 'orphanCoding.noResults' | translate }}</p>
+              </div>
+            </td>
+          </tr>
+        </tbody>
+      </table>
+    </div>
+
+    <!-- Pagination -->
+    <app-pagination
+      *ngIf="totalCount > pageSize"
+      [currentPage]="currentPage"
+      [pageSize]="pageSize"
+      [totalCount]="totalCount"
+      (pageChange)="onPageChange($event)">
+    </app-pagination>
+  </div>
+</div>
+
+<!-- سجل الصرف — the selected orphan's payment history (UC-ORP-08/09) -->
+<app-orphan-payment-history
+  *ngIf="selectedOrphan"
+  [orphan]="selectedOrphan"
+  (closed)="onHistoryClosed()">
+</app-orphan-payment-history>
