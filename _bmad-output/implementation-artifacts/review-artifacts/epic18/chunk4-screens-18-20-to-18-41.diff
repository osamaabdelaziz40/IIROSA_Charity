+      <div class="col-lg-2 col-md-3">
+        <label class="form-label">{{ 'reports.followUpSheets.filterFrom' | translate }}</label>
+        <input type="date" class="form-control" formControlName="dateFrom"
+               [class.is-invalid]="hasServerError('dateFrom')" />
+        <div class="invalid-feedback" *ngIf="hasServerError('dateFrom')">
+          {{ serverError('dateFrom') }}
+        </div>
+      </div>
+      <div class="col-lg-2 col-md-3">
+        <label class="form-label">{{ 'reports.followUpSheets.filterTo' | translate }}</label>
+        <input type="date" class="form-control" formControlName="dateTo" />
+      </div>
+    </form>
+  </div>
+
+  <!-- ==================== the three commands — one screen, the collapsed Crystal trio ==================== -->
+  <div class="d-flex justify-content-between mb-2 gap-2 flex-wrap align-items-center">
+    <div class="btn-group btn-group-sm flex-wrap" role="group"
+         [attr.aria-label]="'reports.followUpSheets.variantGroup' | translate">
+      <button type="button" class="btn"
+              *ngFor="let button of variantButtons; trackBy: trackByVariant"
+              [class.btn-primary]="variant === button.id"
+              [class.btn-outline-primary]="variant !== button.id"
+              (click)="selectVariant(button.id)">
+        {{ button.labelKey | translate }}
+      </button>
+    </div>
+
+    <!-- طباعة — the selected variant's sheet via the epic's browser-print pipeline -->
+    <button type="button" class="btn btn-sm btn-outline-secondary"
+            (click)="printSheetCommand()" [disabled]="printing || loading">
+      <i class="fe fe-printer me-1" *ngIf="!printing; else printSpin"></i>
+      <ng-template #printSpin><span class="spinner-border spinner-border-sm me-1"></span></ng-template>
+      {{ 'reports.followUpSheets.print' | translate }}
+    </button>
+  </div>
+
+  <!-- ==================== bespoke grids — the variant contract's column sets ==================== -->
+  <div report-grid class="table-responsive">
+
+    <!-- متابعة (rptFollowUp) — one row per orphan with its latest accepted report -->
+    <table class="table table-hover table-striped align-middle"
+           *ngIf="rows.length > 0 && variant === 'FollowUp'">
+      <thead>
+        <tr>
+          <th>{{ 'reports.followUpSheets.colSerial' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colOrphanCode' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colOrphanName' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colFamilyCode' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colCharity' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colSponsorshipStatus' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colLastReportDate' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colMonthlyAmount' | translate }}</th>
+        </tr>
+      </thead>
+      <tbody>
+        <tr *ngFor="let row of rows; let i = index; trackBy: trackByRow">
+          <td>{{ serial(i) }}</td>
+          <td>{{ row.orphanCode }}</td>
+          <td>{{ row.orphanName }}</td>
+          <td>{{ row.familyCode || '—' }}</td>
+          <td>{{ row.charityName || '—' }}</td>
+          <td>{{ row.sponsorshipStatus || '—' }}</td>
+          <td>{{ row.lastReportDate | date:'yyyy-MM-dd' }}</td>
+          <td>{{ row.monthlyAmount != null ? row.monthlyAmount : '—' }}</td>
+        </tr>
+      </tbody>
+    </table>
+
+    <!-- متابعة الأسر (rptFollowUpFamily) — one row per family -->
+    <table class="table table-hover table-striped align-middle"
+           *ngIf="rows.length > 0 && variant === 'FollowUpFamily'">
+      <thead>
+        <tr>
+          <th>{{ 'reports.followUpSheets.colSerial' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colFamilyCode' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colHeadOfFamily' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colCharity' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colOrphansCount' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colFamilyStatus' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colRegistrationDate' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colLastUpdate' | translate }}</th>
+        </tr>
+      </thead>
+      <tbody>
+        <tr *ngFor="let row of rows; let i = index; trackBy: trackByRow">
+          <td>{{ serial(i) }}</td>
+          <td>{{ row.familyCode }}</td>
+          <td>{{ row.headOfFamily || '—' }}</td>
+          <td>{{ row.charityName || '—' }}</td>
+          <td>{{ row.orphansCount }}</td>
+          <td>{{ row.familyStatus || '—' }}</td>
+          <td>{{ row.registrationDate | date:'yyyy-MM-dd' }}</td>
+          <td>{{ row.lastUpdate | date:'yyyy-MM-dd' }}</td>
+        </tr>
+      </tbody>
+    </table>
+
+    <!-- تسليم (rptFollowUpTasleem) — the handover sheet with the guardian -->
+    <table class="table table-hover table-striped align-middle"
+           *ngIf="rows.length > 0 && variant === 'Tasleem'">
+      <thead>
+        <tr>
+          <th>{{ 'reports.followUpSheets.colSerial' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colOrphanCode' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colOrphanName' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colGuardian' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colFamilyCode' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colCharity' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colMonthlyAmount' | translate }}</th>
+          <th>{{ 'reports.followUpSheets.colSponsorshipStatus' | translate }}</th>
+        </tr>
+      </thead>
+      <tbody>
+        <tr *ngFor="let row of rows; let i = index; trackBy: trackByRow">
+          <td>{{ serial(i) }}</td>
+          <td>{{ row.orphanCode }}</td>
+          <td>{{ row.orphanName }}</td>
+          <td>{{ row.guardianName || '—' }}</td>
+          <td>{{ row.familyCode || '—' }}</td>
+          <td>{{ row.charityName || '—' }}</td>
+          <td>{{ row.monthlyAmount != null ? row.monthlyAmount : '—' }}</td>
+          <td>{{ row.sponsorshipStatus || '—' }}</td>
+        </tr>
+      </tbody>
+    </table>
+  </div>
+</app-report-viewer>

