+      <div class="col-lg-3 col-md-4" *ngIf="isHQ">
+        <app-drop-down [fg]="filterForm" fcn="charityId"
+                       [label]="'reports.widowsSponsorship.filterCharity'"
+                       [placeholder]="'reports.widowsSponsorship.filterCharity'"
+                       [initialData]="charityOptions">
+        </app-drop-down>
+      </div>
+    </form>
+  </div>
+
+  <!-- ==================== bespoke grid — the 22-column contract (serial + 21) ==================== -->
+  <div report-grid class="table-responsive">
+    <table class="table table-hover table-striped align-middle text-nowrap"
+           *ngIf="rows.length > 0">
+      <thead>
+        <tr>
+          <th>{{ 'reports.widowsSponsorship.colSerial' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colWidowName' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colGovernorate' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colCenter' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colVillage' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colAddress' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colMobile2' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colMobile1' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colHouseOwnership' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colRentValue' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colHousingType' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colHouseStatus' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colIncomeValue' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colHusbandDeathDate' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colDevelopmentProject' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colEducation' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colProfession' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colHealthStatus' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colNationalId' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colNotes' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colCharity' | translate }}</th>
+          <th>{{ 'reports.widowsSponsorship.colLastUpdated' | translate }}</th>
+        </tr>
+      </thead>
+      <tbody>
+        <tr *ngFor="let row of rows; let i = index; trackBy: trackByRow">
+          <td>{{ serial(i) }}</td>
+          <td>{{ row.widowName }}</td>
+          <td>{{ row.governorateName || '—' }}</td>
+          <td>{{ row.centerName || '—' }}</td>
+          <td>{{ row.cityVillage || '—' }}</td>
+          <td>{{ row.detailedAddress || '—' }}</td>
+          <!-- no backing column — renders blank by contract -->
+          <td>{{ row.mobileNumber2 || '—' }}</td>
+          <td>{{ row.mobileNumber || '—' }}</td>
+          <td>{{ row.houseOwnershipName || '—' }}</td>
+          <td>{{ row.rentAmount ?? '—' }}</td>
+          <td>{{ row.housingTypeName || '—' }}</td>
+          <td>{{ row.houseStatusName || '—' }}</td>
+          <td>{{ row.monthlyIncome ?? '—' }}</td>
+          <td>{{ row.husbandDeathDate ? (row.husbandDeathDate | date:'yyyy-MM-dd') : '—' }}</td>
+          <!-- no backing column — renders blank by contract -->
+          <td>{{ row.developmentProject || '—' }}</td>
+          <td>{{ row.educationLevelName || '—' }}</td>
+          <td>{{ row.profession || '—' }}</td>
+          <td>{{ row.healthStatusName || '—' }}</td>
+          <td>{{ row.nationalId || '—' }}</td>
+          <td>{{ row.notes || '—' }}</td>
+          <td>{{ row.charityName || '—' }}</td>
+          <td>{{ row.lastUpdatedDate ? (row.lastUpdatedDate | date:'yyyy-MM-dd') : '—' }}</td>
+        </tr>
+      </tbody>
+    </table>
+  </div>
+</app-report-viewer>

