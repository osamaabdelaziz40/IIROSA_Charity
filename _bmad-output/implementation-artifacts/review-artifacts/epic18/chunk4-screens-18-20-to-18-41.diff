--- /dev/null
+++ b/Frontend/src/app/modules/reports/non-renewed-reports/batch-non-renewed-reports.component.html
@@ -0,0 +1,57 @@
+<app-report-viewer titleKey="reports.nonRenewed.title"
+                   subtitleKey="reports.nonRenewed.subtitle"
+                   [loading]="loading"
+                   [exporting]="exporting"
+                   [hasRun]="hasRun"
+                   [currentPage]="currentPage"
+                   [pageSize]="pageSize"
+                   [totalCount]="totalCount"
+                   (search)="search()"
+                   (export)="exportData()"
+                   (pageChange)="onPageChange($event)">
+
+  <!-- ==================== filter panel (charity + batch) ==================== -->
+  <div report-filters>
+    <form [formGroup]="filterForm" (ngSubmit)="search()" class="row g-3 align-items-end">
+      <div class="col-lg-3 col-md-4" *ngIf="isHQ">
+        <app-drop-down [fg]="filterForm" fcn="charityId"
+                       [label]="'reports.nonRenewed.filterCharity'"
+                       [placeholder]="'reports.nonRenewed.filterCharity'"
+                       [initialData]="charityOptions">
+        </app-drop-down>
+      </div>
+      <div class="col-lg-3 col-md-4">
+        <app-drop-down [fg]="filterForm" fcn="batchId"
+                       [label]="'reports.nonRenewed.filterBatch'"
+                       [placeholder]="'reports.nonRenewed.filterBatch'"
+                       [initialData]="batchOptions">
+        </app-drop-down>
+      </div>
+    </form>
+  </div>
+
+  <!-- ==================== bespoke grid — serial + charity + code + name + batch ==================== -->
+  <div report-grid class="table-responsive">
+    <table class="table table-hover table-striped align-middle text-nowrap"
+           *ngIf="rows.length > 0">
+      <thead>
+        <tr>
+          <th>{{ 'reports.nonRenewed.colSerial' | translate }}</th>
+          <th>{{ 'reports.nonRenewed.colCharity' | translate }}</th>
+          <th>{{ 'reports.nonRenewed.colOrphanCode' | translate }}</th>
+          <th>{{ 'reports.nonRenewed.colOrphanName' | translate }}</th>
+          <th>{{ 'reports.nonRenewed.colBatch' | translate }}</th>
+        </tr>
+      </thead>
+      <tbody>
+        <tr *ngFor="let row of rows; let i = index; trackBy: trackByRow">
+          <td>{{ serial(i) }}</td>
+          <td>{{ row.charityName || '—' }}</td>
+          <td>{{ row.code || '—' }}</td>
+          <td>{{ row.fullName }}</td>
+          <td>{{ row.batchNo || '—' }}</td>
+        </tr>
+      </tbody>
+    </table>
+  </div>
+</app-report-viewer>

