+        </div>
+      </div>
+      <div class="col-lg-2 col-md-3">
+        <label class="form-label">{{ 'reports.missingOutgoingAttachments.filterTo' | translate }}</label>
+        <input type="date" class="form-control" formControlName="dateTo" />
+      </div>
+    </form>
+  </div>
+
+  <!-- ==================== bespoke grid — the audit list, query/grid-only by design ==================== -->
+  <div report-grid class="table-responsive">
+    <table class="table table-hover table-striped align-middle"
+           *ngIf="rows.length > 0">
+      <thead>
+        <tr>
+          <th>{{ 'reports.missingOutgoingAttachments.colSerial' | translate }}</th>
+          <th>{{ 'reports.missingOutgoingAttachments.colOutGoingNumber' | translate }}</th>
+          <th>{{ 'reports.missingOutgoingAttachments.colSubject' | translate }}</th>
+          <th>{{ 'reports.missingOutgoingAttachments.colDate' | translate }}</th>
+          <th>{{ 'reports.missingOutgoingAttachments.colYear' | translate }}</th>
+          <th>{{ 'reports.missingOutgoingAttachments.colCategory' | translate }}</th>
+          <th>{{ 'reports.missingOutgoingAttachments.colCharity' | translate }}</th>
+          <th>{{ 'reports.missingOutgoingAttachments.colAttachmentCount' | translate }}</th>
+        </tr>
+      </thead>
+      <tbody>
+        <tr *ngFor="let row of rows; trackBy: trackByRow">
+          <!-- مسلسل الصادر — the register's own serial, not a running index -->
+          <td>{{ row.serial ?? '—' }}</td>
+          <td>{{ row.outGoingNumber || '—' }}</td>
+          <td>{{ row.subject || '—' }}</td>
+          <td>{{ row.date | date:'yyyy-MM-dd' }}</td>
+          <td>{{ row.year ?? '—' }}</td>
+          <td>{{ row.categoryName || '—' }}</td>
+          <td>{{ row.charityName || '—' }}</td>
+          <td>{{ row.attachmentCount }}</td>
+        </tr>
+      </tbody>
+    </table>
+  </div>
+</app-report-viewer>

