+<app-report-viewer titleKey="reports.beneficiaryFamilyDetails.title"
+                   subtitleKey="reports.beneficiaryFamilyDetails.subtitle"
+                   [loading]="loading"
+                   [exporting]="exporting"
+                   [hasRun]="hasRun"
+                   [currentPage]="currentPage"
+                   [pageSize]="pageSize"
+                   [totalCount]="totalCount"
+                   (search)="search()"
+                   (export)="exportData()"
+                   (pageChange)="onPageChange($event)">
+
+  <!-- ==================== §23.S.13 filter panel (1 field) ==================== -->
+  <div report-filters>
+    <form [formGroup]="filterForm" (ngSubmit)="search()" class="row g-3 align-items-end">
+      <!-- HQ narrow; a charity caller is pinned server-side anyway -->
+      <div class="col-lg-3 col-md-4" *ngIf="isHQ">
+        <app-drop-down [fg]="filterForm" fcn="charityId"
+                       [label]="'reports.beneficiaryFamilyDetails.filterCharity'"
+                       [placeholder]="'reports.beneficiaryFamilyDetails.filterCharity'"
+                       [initialData]="charityOptions">
+        </app-drop-down>
+      </div>
+    </form>
+  </div>
+
+  <!-- ==================== bespoke grid — the §23.S.13 contract (serial + 6) ==================== -->
+  <div report-grid class="table-responsive">
+    <table class="table table-hover table-striped align-middle text-nowrap"
+           *ngIf="rows.length > 0">
+      <thead>
+        <tr>
+          <th>{{ 'reports.beneficiaryFamilyDetails.colSerial' | translate }}</th>
+          <th>{{ 'reports.beneficiaryFamilyDetails.colFamilyCode' | translate }}</th>
+          <th>{{ 'reports.beneficiaryFamilyDetails.colHeadOfFamily' | translate }}</th>
+          <th>{{ 'reports.beneficiaryFamilyDetails.colPhone' | translate }}</th>
+          <th>{{ 'reports.beneficiaryFamilyDetails.colAddress' | translate }}</th>
+          <th>{{ 'reports.beneficiaryFamilyDetails.colCharity' | translate }}</th>
+          <th>{{ 'reports.beneficiaryFamilyDetails.colCampaigns' | translate }}</th>
+        </tr>
+      </thead>
+      <tbody>
+        <tr *ngFor="let row of rows; let i = index; trackBy: trackByRow">
+          <td>{{ serial(i) }}</td>
+          <td>{{ row.familyCode }}</td>
+          <td>{{ row.headOfFamilyName || '—' }}</td>
+          <td>{{ row.phone || '—' }}</td>
+          <td>{{ row.address || '—' }}</td>
+          <td>{{ row.charityName || '—' }}</td>
+          <td>{{ row.campaignNames || '—' }}</td>
+        </tr>
+      </tbody>
+    </table>
+  </div>
+</app-report-viewer>

