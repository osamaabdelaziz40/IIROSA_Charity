+<app-report-viewer titleKey="reports.orphansWithoutPayment.title"
+                   subtitleKey="reports.orphansWithoutPayment.subtitle"
+                   [loading]="loading"
+                   [showExport]="false"
+                   [hasRun]="hasRun"
+                   [currentPage]="currentPage"
+                   [pageSize]="pageSize"
+                   [totalCount]="totalCount"
+                   (search)="search()"
+                   (pageChange)="onPageChange($event)">
+
+  <!-- ==================== §23.U.28 filter panel ==================== -->
+  <div report-filters>
+    <form [formGroup]="filterForm" (ngSubmit)="search()" class="row g-3 align-items-end">
+      <!-- الدفعة — mandatory: the batch is the report's frame -->
+      <div class="col-lg-3 col-md-4">
+        <app-drop-down [fg]="filterForm" fcn="paymentId"
+                       [label]="'reports.orphansWithoutPayment.filterBatch'"
+                       [placeholder]="'reports.orphansWithoutPayment.filterBatch'"
+                       [initialData]="batchOptions">
+        </app-drop-down>
+        <div class="text-danger small mt-1"
+             *ngIf="filterForm.get('paymentId')?.invalid && filterForm.get('paymentId')?.touched">
+          {{ 'reports.orphansWithoutPayment.batchRequired' | translate }}
+        </div>
+      </div>
+      <!-- الجمعية — HQ narrow only -->
+      <div class="col-lg-3 col-md-4" *ngIf="isHQ">
+        <app-drop-down [fg]="filterForm" fcn="charityId"
+                       [label]="'reports.orphansWithoutPayment.filterCharity'"
+                       [placeholder]="'reports.orphansWithoutPayment.filterCharity'"
+                       [initialData]="charityOptions">
+        </app-drop-down>
+      </div>
+      <div class="col-lg-3 d-flex flex-wrap gap-2">
+        <button type="submit" class="btn btn-primary" [disabled]="loading">
+          {{ 'reports.orphansWithoutPayment.search' | translate }}
+        </button>
+      </div>
+    </form>
+  </div>
+
+  <!-- ==================== §23.U.28 gap grid ==================== -->
+  <div report-grid class="table-responsive">
+    <table class="table table-hover table-striped align-middle text-nowrap"
+           *ngIf="rows.length > 0">
+      <thead>
+        <tr>
+          <th>{{ 'reports.orphansWithoutPayment.colSerial' | translate }}</th>
+          <th>{{ 'reports.orphansWithoutPayment.colOrphanCode' | translate }}</th>
+          <th>{{ 'reports.orphansWithoutPayment.colOrphanName' | translate }}</th>
+          <th>{{ 'reports.orphansWithoutPayment.colCharity' | translate }}</th>
+          <th>{{ 'reports.orphansWithoutPayment.colExpectedAmount' | translate }}</th>
+          <th>{{ 'reports.orphansWithoutPayment.colDisbursementState' | translate }}</th>
+        </tr>
+      </thead>
+      <tbody>
+        <tr *ngFor="let row of rows; let i = index; trackBy: trackByRow">
+          <td>{{ serial(i) }}</td>
+          <td>{{ row.orphanCode }}</td>
+          <td>{{ row.orphanName }}</td>
+          <td>{{ row.charityName || '—' }}</td>
+          <td>{{ row.amount }}</td>
+          <td>
+            <!-- وقف الصرف marks the stopped subset; the rest are simply لم يتم الصرف -->
+            <span class="badge badge-danger" *ngIf="row.isStopped">
+              {{ 'reports.orphansWithoutPayment.stateStopped' | translate }}
+            </span>
+            <span class="badge badge-secondary" *ngIf="!row.isStopped">
+              {{ 'reports.orphansWithoutPayment.stateNotDisbursed' | translate }}
+            </span>
+          </td>
+        </tr>
+      </tbody>
+    </table>
+  </div>
+</app-report-viewer>

