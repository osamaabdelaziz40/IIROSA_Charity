+        <app-drop-down [fg]="filterForm" fcn="outgoingCategoryId"
+                       [label]="'reports.missingOutgoingAttachments.filterCategory'"
+                       [placeholder]="'reports.missingOutgoingAttachments.filterCategory'"
+                       [initialData]="categoryOptions">
+        </app-drop-down>
+      </div>
+
+      <div class="col-lg-2 col-md-3">
+        <label class="form-label">{{ 'reports.missingOutgoingAttachments.filterFrom' | translate }}</label>
