+            .NotEmpty()
+            .WithMessage("Batch number is required");
+
+        RuleFor(x => x.Variant)
+            .Must(v => Variants.Contains(v, StringComparer.OrdinalIgnoreCase))
+            .WithMessage("Variant must be one of: received, notReceived, stopped");
+    }
+}

