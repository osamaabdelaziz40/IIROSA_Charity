+                .Select(c => c.Id);
+            query = query.Where(o => countryCharityIds.Contains(o.FK_CharityId!.Value));
+        }
+
+        var totalCount = await query.CountAsync(cancellationToken);
+        var rows = await query
+            .OrderByDescending(o => o.Date)
