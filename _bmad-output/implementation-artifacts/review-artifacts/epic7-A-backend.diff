+        }
+
+        _logger.LogInformation(
+            "Family {FamilyId} transferred from charity {FromCharityId} to {ToCharityId} ({OrphanCount} orphans cascaded)",
+            familyId, fromCharityId, dto.NewCharityId, orphans.Count);
+    }
